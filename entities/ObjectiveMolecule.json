{
  "type": "object",
  "properties": {
    "om_id": {
      "type": "string"
    },
    "auth_input_id": {
      "type": "string"
    },
    "singular_goal": {
      "type": "string"
    },
    "success_condition": {
      "type": "string"
    },
    "exclusion_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hard",
              "soft"
            ]
          },
          "rule": {
            "type": "string"
          },
          "acf": {
            "type": "object",
            "properties": {
              "observable_condition": {
                "type": "string"
              },
              "allowed_transition": {
                "type": "string"
              },
              "forbidden_transitions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verification_method": {
                "type": "string"
              }
            },
            "description": "Atomic Constraint Form \u2014 CAR-1"
          },
          "determinism_score": {
            "type": "number"
          },
          "cdc_valid": {
            "type": "boolean"
          }
        }
      }
    },
    "confidence": {
      "type": "number"
    },
    "lineage_hash": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "rejected",
        "superseded"
      ]
    },
    "rejection_reason": {
      "type": "string"
    },
    "candidate_siblings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolation_domain_id": {
      "type": "string",
      "description": "MOCL-1: sealed causal domain ID"
    },
    "ccc_valid": {
      "type": "boolean"
    },
    "car_valid": {
      "type": "boolean"
    },
    "execution_manifold_id": {
      "type": "string",
      "description": "CGS-1"
    },
    "version": {
      "type": "integer",
      "description": "Monotonic version counter \u2014 TCL-1"
    },
    "singular_goal_hash": {
      "type": "string",
      "description": "TCL-1: hash of singular_goal, must be stable for same om_id"
    },
    "execution_graph_hash": {
      "type": "string",
      "description": "TCL-1: hash of last execution graph \u2014 TCI comparison baseline"
    },
    "temporal_spine_id": {
      "type": "string",
      "description": "TCL-1: ID of first FabricTimeChain entry for this OM"
    },
    "superseded_by": {
      "type": "string",
      "description": "om_id of successor OM if this one was superseded"
    },
    "tci_holds": {
      "type": "boolean",
      "description": "TCL-1: Temporal Coherence Invariant \u2014 false means drift detected"
    }
  },
  "required": [
    "singular_goal",
    "success_condition",
    "status"
  ],
  "name": "ObjectiveMolecule"
}